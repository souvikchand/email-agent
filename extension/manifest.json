{
  "manifest_version": 3,
  "name": "Email agent",
  "version": "1.0",
  "description": "A brief description of my extension",
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "128": "icons/icon.png"
  }
  
}